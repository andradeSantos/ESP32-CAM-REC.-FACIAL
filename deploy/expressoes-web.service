[Unit]
Description=ESP32-CAM Expressoes - Frontend Next.js
After=network.target expressoes-api.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/esp32cam-expressoes/web
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=0.0.0.0
Environment=BACKEND_URL=http://127.0.0.1:5000
ExecStart=/usr/bin/node .next/standalone/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
