[Unit]
Description=ESP32-CAM Expressoes - Backend API (Gunicorn + ONNX)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/esp32cam-expressoes/pc
EnvironmentFile=-/opt/esp32cam-expressoes/pc/.env
ExecStart=/opt/esp32cam-expressoes/pc/.venv/bin/gunicorn --workers 1 --threads 8 --timeout 30 --bind 0.0.0.0:5000 wsgi:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
