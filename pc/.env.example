# Configurações do Servidor de Expressões (Local / Produção VPS)
# Copie este arquivo para .env e ajuste conforme o ambiente.

# Host e porta de escuta da API Python
EXP_HOST=0.0.0.0
EXP_PORT=5000

# Senha para acesso ao Dashboard Web (se vazio, lê/cria pc/senha_web.txt)
EXP_WEB_PASSWORD=

# Chave de API para autenticação do ESP32-CAM via header X-API-Key (se vazio, lê/cria pc/chave_api.txt)
EXP_API_KEY=

# Permite envios de dispositivos na rede local sem X-API-Key (true localmente, false na VPS)
EXP_ALLOW_LOCAL_NO_KEY=true

# Ative (true) quando estiver atrás de proxy reverso (Nginx / Cloudflare) na VPS
EXP_TRUST_PROXY=false

# Limite mínimo de confiança para não classificar como INCONCLUSIVE (padrão: 0.40)
EXP_CONFIDENCE_LIMIT=0.40

# Origens permitidas no CORS (ex: https://seu-dominio.com ou * para desenvolvimento)
EXP_CORS_ORIGINS=*
